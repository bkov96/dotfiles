services:
  qbittorrent:
    image: ghcr.io/hotio/qbittorrent:release-v5.1.4
    container_name: qbittorrent
    restart: unless-stopped
    environment:
      - PUID=501
      - PGID=20
      - UMASK=002
      - TZ=Europe/Budapest
    volumes:
      - ${SERVICES_DATA_DIR}/qbittorrent:/config
      - ${MEDIA_ROOT}:/media
    networks:
      - caddy_proxy
      - default
      - metrics_internal

networks:
  caddy_proxy:
    external: true
  metrics_internal:
    external: true
