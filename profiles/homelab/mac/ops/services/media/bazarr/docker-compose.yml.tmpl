services:
  bazarr:
    image: ghcr.io/hotio/bazarr:release-1.5.6
    container_name: bazarr
    restart: unless-stopped
    environment:
      - PUID=501
      - PGID=20
      - UMASK=002
      - TZ=Europe/Budapest
    volumes:
      - ${SERVICES_DATA_DIR}/bazarr:/config
      - ${MEDIA_ROOT}:/media
    networks:
      - caddy_proxy
      - default
      - metrics_internal

networks:
  caddy_proxy:
    external: true
  metrics_internal:
    external: true
