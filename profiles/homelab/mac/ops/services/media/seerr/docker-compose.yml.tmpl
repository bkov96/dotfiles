services:
  seerr:
    image: seerr/seerr:v3.2.0
    container_name: seerr
    restart: unless-stopped
    init: true
    environment:
      - TZ=Europe/Budapest
      - PORT=5055
    volumes:
      - ${SERVICES_DATA_DIR}/seerr:/app/config
    healthcheck:
      test: ["CMD", "wget", "--no-verbose", "--tries=1", "--spider", "http://localhost:5055/api/v1/settings/public"]
      interval: 15s
      timeout: 3s
      start_period: 20s
      retries: 3
    networks:
      - caddy_proxy
      - default

networks:
  caddy_proxy:
    external: true
