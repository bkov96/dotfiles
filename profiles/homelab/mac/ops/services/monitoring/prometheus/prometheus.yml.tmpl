global:
  scrape_interval: 15s
  evaluation_interval: 15s
  external_labels:
    monitor: homelab

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets:
          - localhost:9090

  - job_name: node
    static_configs:
      - targets:
          - host.docker.internal:9100

  - job_name: macmon
    static_configs:
      - targets:
          - host.docker.internal:9190

  - job_name: caddy
    static_configs:
      - targets:
          - caddy:2019

  - job_name: exportarr-sonarr
    static_configs:
      - targets:
          - exportarr-sonarr:9707

  - job_name: exportarr-radarr
    static_configs:
      - targets:
          - exportarr-radarr:9708

  - job_name: exportarr-prowlarr
    static_configs:
      - targets:
          - exportarr-prowlarr:9709

  - job_name: exportarr-bazarr
    static_configs:
      - targets:
          - exportarr-bazarr:9710

  # With ENABLE_ADDITIONAL_METRICS on, the Lidarr collector issues two API
  # calls per artist sequentially on every scrape, and v2.3.0 has no
  # overlap protection — a 15s interval would stack collections against
  # Lidarr as the library grows. No other job overrides the global interval.
  - job_name: exportarr-lidarr
    scrape_interval: 60s
    static_configs:
      - targets:
          - exportarr-lidarr:9711

  - job_name: qbittorrent
    static_configs:
      - targets:
          - qbittorrent-exporter:17871

  - job_name: jellyfin
    static_configs:
      - targets:
          - jellyfin-exporter:9594

  - job_name: seerr
    static_configs:
      - targets:
          - seerr-exporter:9850

  - job_name: navidrome
    basic_auth:
      username: navidrome
      password: ${NAVIDROME_METRICS_PASSWORD}
    static_configs:
      - targets:
          - navidrome:4533
